{
  "compilerOptions": {
    "target": "es2025",
    "jsx": "react-jsx",
    "module": "ES2022",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./*"],
      "@client/*": ["./src/client/*"],
      "@components/*": ["./src/client/components/*"],
      "@public/*": ["./public/*"],
      "@server": ["./src/index.ts"],
      "@server/*": ["./src/server/*"]
    }
  },
  "include": ["globals.d.ts", "**/*.ts", "**/*.tsx"]
}
