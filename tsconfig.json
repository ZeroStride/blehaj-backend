{
  "compilerOptions": {
    "target": "es2025",
    "jsx": "preserve",
    "module": "ES2022",
    "types": [
      "bun-types"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "*": [
        "./*"
      ],
      "@server": [
        "./src/index.ts"
      ],
      "@server/*": [
        "./src/*"
      ],
      "@public/*": [
        "./public/*"
      ]
    }
  },
  "include": [
    "globals.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}